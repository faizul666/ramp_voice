# Copy this file to .env and fill in ONE key. .env is gitignored (never committed).
# DeepSeek (recommended — cheap, OpenAI-compatible): platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-key

# Or Gemini instead (leave DeepSeek blank to use this): aistudio.google.com
# GOOGLE_API_KEY=your-gemini-key

# --- Supabase (the /book endpoint writes bookings here) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: require this value in an x-api-key header to call /book
# BOOK_API_SECRET=some-long-random-string

# --- Twilio (real confirmation message from /book; all optional — none if unset) ---
# console.twilio.com  (Account SID + Auth Token on the dashboard)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# WhatsApp (works to Bangladesh on trial via the sandbox). Set this and it wins.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Plain SMS fallback (used only if TWILIO_WHATSAPP_FROM is unset). US long codes
# can't reach BD, so for a BD demo use WhatsApp above instead.
# TWILIO_FROM_NUMBER=+14843834929
# Demo recipient when the flow has no caller phone. On a Twilio TRIAL this must be
# a number that has joined the WhatsApp sandbox (or a verified SMS number).
SMS_TO_FALLBACK=+8801773807602
